[Unit]
Description=Tin Hat Server manager (setup wizard, dashboard, console banner)
Documentation=file:///opt/tinhat/README
After=docker.service network-online.target avahi-daemon.service
Wants=docker.service network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/tinhat/manager
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=/usr/bin/python3 -m tinhat
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
