[Unit]
Description=Tin Hat names service: back up the database, keys and zone (restic, off this machine)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/tinhat-names/tinhat-names -c /etc/tinhat-names/config.json backup
Environment=RESTIC_CACHE_DIR=/var/lib/tinhat-names/restic-cache
User=tinhat-names
Group=tinhat-names
StateDirectory=tinhat-names
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
