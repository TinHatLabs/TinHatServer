# Copy to .env next to docker-compose.yml to change these.
# A fixed version instead of the newest (updates then happen when you change this):
# TINHAT_VERSION=0.3.0
# Behind your own reverse proxy ON THIS MACHINE (nginx, Caddy, Traefik, Nginx Proxy Manager, also in a container) that
# keeps ports 80 and 443. A proxy on another computer doesn't need this: choose My own reverse proxy at setup.
# TINHAT_BEHIND_PROXY=1
